# Ignore everything by default
*

# Allow gitignore and README
!.gitignore
!README.md

# Allow QuestSystem plugin
!/Plugins/
!/Plugins/QuestSystem/
!/Plugins/QuestSystem/**

# Exclude build artifacts
/Plugins/QuestSystem/Binaries/
/Plugins/QuestSystem/Intermediate/
/Plugins/QuestSystem/DerivedDataCache/
/Binaries/
/Intermediate/
/DerivedDataCache/
/Saved/
