# Ignore everything by default
*

# Allow gitignore, project descriptor, and README
!.gitignore
!README.md
!*.uproject

# Allow project target source stubs
!/Source/
!/Source/**

# Allow QuestSystem plugin
!/Plugins/
!/Plugins/QuestSystem/
!/Plugins/QuestSystem/**

# Exclude build artifacts
/Plugins/QuestSystem/Binaries/
/Plugins/QuestSystem/Intermediate/
/Plugins/QuestSystem/DerivedDataCache/
/Binaries/
/Intermediate/
/DerivedDataCache/
/Saved/
